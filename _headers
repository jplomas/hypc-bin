# Netlify response headers for binaries.theqrl.org.
# Versioned binaries never change (the file name embeds the compiler commit and CI forbids
# modifying an existing file), so they can be cached forever. list.json changes when a version
# is added and must be revalidated.
/bin/hypjson-*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/bin/list.json
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
